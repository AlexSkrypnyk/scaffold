{
    "name": "alexskrypnyk/scaffold-tests",
    "description": "Tests for Scaffold project functionality.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "homepage": "https://www.drevops.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/alexskrypnyk/scaffold",
    "support": {
        "issues": "https://github.com/alexskrypnyk/scaffold/issues",
        "source": "https://github.com/alexskrypnyk/scaffold"
    },
    "require": {
        "php": ">=8.3",
        "alexskrypnyk/file": "^1.4.1",
        "alexskrypnyk/phpunit-helpers": "^1.2.1",
        "alexskrypnyk/snapshot": "^1.6.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drupal/coder": "^9.0.1",
        "ergebnis/composer-normalize": "^2.57.0",
        "laravel/serializable-closure": "^2.2.0",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^12.5.44",
        "rector/rector": "^2.8.4",
        "symfony/filesystem": "^7.4.23",
        "symfony/finder": "^7.4.23",
        "symfony/process": "^7.4.22"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AlexSkrypnyk\\Scaffold\\Tests\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "bump-after-update": true,
        "discard-changes": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan",
            "rector --clear-cache --dry-run"
        ],
        "lint-fix": [
            "rector --clear-cache",
            "phpcbf"
        ],
        "test": "phpunit",
        "update-snapshots": "./vendor/bin/update-snapshots --test-dir=src testInstall fixtures/install"
    }
}
